#N canvas 180 80 900 620 12;
#X declare -lib xlab -lib bhack;
#X text 30 24 x.rhythm - quantize onset times into a bhack x.rhythm tree;
#X text 30 52 Arguments: bpm(0=auto) numerator denominator maxdivision tolerance-ms;
#X obj 404 338 x.rhythm 60 4 4 8 50;
#X msg 30 118 0 333.333 666.667 1000;
#X text 30 91 quarter-note triplet at 60 BPM;
#X msg 30 184 0 200 400 600 800 1000;
#X text 30 157 quarter-note quintuplet at 60 BPM;
#X msg 30 250 0 250 500 750 1000;
#X text 30 223 straight sixteenths;
#X msg 404 118 bpm 60;
#X msg 404 151 timesig 4 4;
#X msg 404 184 maxdivision 8;
#X msg 404 217 tolerance 50;
#X obj 404 402 bhack.voice 440 120;
#X floatatom 644 370 8 0 0 1 BPM - - 0;
#X text 30 305 The left outlet is a dddd tree ready for bhack.voice.;
#X text 30 329 The right outlet reports the fixed or estimated BPM.;
#X text 30 368 Tuplet intent is tempo-dependent. Set bpm explicitly when possible.;
#X text 30 410 Input must be strictly increasing onset times in milliseconds.;
#X text 30 452 Quantization errors up to tolerance milliseconds are accepted.;
#X connect 3 0 14 0;
#X connect 3 1 15 0;
#X connect 4 0 3 0;
#X connect 6 0 3 0;
#X connect 8 0 3 0;
#X connect 10 0 3 0;
#X connect 11 0 3 0;
#X connect 12 0 3 0;
#X connect 13 0 3 0;

#X obj 30 253 *~ 0.25;
#X obj 210 250 bng 24 250 50 0 empty empty CAPTURE 30 12 0 10 #fcfcfc #000000 #000000;
#X text 30 170 Live input (replace with adc~ if desired);
#X obj 30 323 vb.freezer~ \$0-loop 250;
#X floatatom 30 356 10 0 0 0 loop_samples - - 0;
#X obj 217 356 bng 20 250 50 0 empty empty DONE 25 10 0 10 #fcfcfc #000000 #000000;
#X obj 30 410 tgl 20 0 empty empty LOOP_PLAYBACK 25 10 0 10 #fcfcfc #000000 #000000 0 1;
#X obj 30 444 sel 0 1;
#X msg 30 474 stop;

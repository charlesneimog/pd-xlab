#N canvas 70 60 1080 800 12;
#X obj 30 135 bng 22 250 50 0 empty empty impulse 28 11 0 12 #fcfcfc #000000 #000000;
#X msg 30 175 1 0 \, 0 0 1;
#X obj 30 210 vline~;
#X obj 30 245 *~ 0.2;
#X obj 30 390 x.cloudseed.rev~ 0.4;
#X obj 30 440 *~ 0.3;
#X obj 210 440 *~ 0.3;
#X obj 30 485 dac~;
#X obj 250 135 tgl 22 0 empty empty DSP 28 11 0 12 #fcfcfc #000000 #000000 0 1;
#X msg 250 175 \; pd dsp \$1;
#X floatatom 400 135 5 0 1 0 mix - - 0;
#X msg 400 175 mix \$1;
#X msg 400 225 LateLineDecay 0.63;
#X msg 400 260 LateLineSize 0.47;
#X msg 400 295 HighCutEnabled 1 \, HighCut 0.5;
#X msg 700 225 param LateDiffuseFeedback 0.75;
#X msg 700 260 param 28 0.5;
#X msg 400 340 clear;
#X msg 480 340 reset;
#X msg 560 340 parameters;
#X text 30 20 x.cloudseed.rev~ - stereo CloudSeedCore reverb;
#X text 30 50 Two signal inlets (L/R) and two signal outlets (L/R). Send mono to both inputs.;
#X text 30 75 Based on the CloudSeedCore Dark Plate preset. Creation: x.cloudseed.rev~ [mix].;
#X text 30 100 Enable DSP and click impulse to hear the tail. The example starts at mix 0.4.;
#X text 400 395 Parameter values use CloudSeedCore's normalized 0..1 scale.;
#X text 400 420 Names are case sensitive. Numeric param indices range from 0 to 44.;
#X text 400 445 parameters: print every index/name/current/scaled value in Pd's console.;
#X text 30 540 mix 0..1: linear dry/engine blend (default 1 = wet only).;
#X text 30 565 clear: erase the tail while retaining parameters and mix.;
#X text 30 590 reset: restore Dark Plate with DryOut 0 and mix 1 \, then clear the tail.;
#X text 30 615 DryOut/EarlyOut/LateOut: normalized output gains (0 = mute \, 1 = 0 dB).;
#X text 30 640 Keep DryOut at 0 when using mix for the dry/wet balance.;
#X text 30 665 Supports 8-192 kHz and arbitrary Pd block sizes. Core processing is float32.;
#X text 30 705 DSP by Ghost Note Audio / Ghost Note Engineering Ltd (MIT). Pd wrapper by pd-xlab.;
#X text 30 730 This independent Pd external uses CloudSeedCore and is not a Ghost Note Audio product.;
#X text 30 755 Source: https://github.com/GhostNoteAudio/CloudSeedCore;
